{
  "manifest_version": 3,
  "name": "PDF 划词翻译",
  "version": "0.1.2",
  "description": "在 PDF 里选中文字，用 DeepSeek 在选区旁查看中文译文。",
  "minimum_chrome_version": "151",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "PDF 划词翻译",
    "default_icon": "icon.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api.deepseek.com/*", "https://arxiv.org/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "vendor/pdfjs/web/viewer.html"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
